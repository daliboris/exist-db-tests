<?xml version="1.0" encoding="UTF-8"?><meta xmlns="http://exist-db.org/xquery/repo">
    <description>Users with install script</description>
    <author>Boris Lehečka</author>
    <website>https://jinntec.de</website>
    <status>beta</status>
    <license>GPLv3</license>
    <copyright>true</copyright>
    <type>library</type>
    <target>users-with-script</target>
    <!-- <prepare>pre-install.xql</prepare> -->
    <finish>post-install.xql</finish><!-- used for creating additional users -->
    
    <!-- First user is automatically created during the installation process -->
    <permissions user="users-installer" mode="---------" group="install" description="User used for creating other groups and users"/>
    
    <!-- Groups-->
    <permissions user="-" mode="---------" group="redaction"
        description="Redaction group" />
    <permissions user="-" mode="---------" group="annotation"
        description="Annotation group" />
    <permissions user="-" mode="---------" group="administration"
        description="Administration group" />
    <!-- Users -->

    <!-- Users -->
    <permissions user="editor-only" password="pswd" group="tei"
        mode="rw-rwxr--" groups="redaction administration" full-name="Editor Only"
        description="Editor of the edition (and an admin)" />
    <permissions user="annotator" password="pswd" group="tei"
        mode="rw-rwxr--" groups="annotation" full-name="Annotator User"
        description="Annotator of the edition" />

    <changelog>
        <change version="0.2.0">
            <ul xmlns="http://www.w3.org/1999/xhtml">
                <li>creates groups</li>
                <li>creates multiple users beloging to multiple groups</li>
            </ul>
        </change>
    </changelog>
</meta>
